# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram API Credentials
# Get these from https://my.telegram.org/auth
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Owner Configuration
# Your Telegram user ID - get from @userinfobot
OWNER_ID=987654321

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Database Configuration
DATABASE_PATH=security_bot.db

# Session Security
# Use a random, secure string for production
SESSION_ENCRYPTION_KEY=change-this-to-a-random-secure-string

# Security Thresholds (Optional)
# Mass-Ban Protection
BAN_LIMIT_1=5
BAN_WINDOW_1=60
BAN_LIMIT_2=15
BAN_WINDOW_2=300

# Mass-Delete Protection
DELETE_LIMIT_1=10
DELETE_WINDOW_1=60
DELETE_LIMIT_2=30
DELETE_WINDOW_2=300

# Timezone (Optional)
TIMEZONE=Asia/Kolkata
